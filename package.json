{
  "name": "ai-command-center",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @acc/desktop",
    "build": "npm run build -w @acc/desktop",
    "test": "vitest run",
    "lint": "tsc --noEmit -p packages/core && tsc --noEmit -p apps/desktop",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p apps/desktop",
    "package": "npm run package -w @acc/desktop",
    "e2e": "node tools/e2e/run.mjs"
  },
  "overrides": {
    "katex": "^0.19.1"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0"
  }
}
