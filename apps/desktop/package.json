{
  "name": "@acc/desktop",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "build:main": "esbuild src/main/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/main/main.cjs && esbuild src/preload/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/main/preload.cjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dev": "npm run build:main && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env ACC_DEV=1 electron .\"",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@lydell/node-pty": "^1.2.0-beta.18",
    "electron-updater": "^6.8.11",
    "katex": "^0.19.1",
    "mermaid": "^12.3.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@acc/core": "*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^38.0.0",
    "electron-builder": "^25.1.0",
    "esbuild": "^0.24.0",
    "lucide-react": "^0.454.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.26.0",
    "reactflow": "^11.11.4",
    "recharts": "^2.13.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0",
    "zustand": "^4.5.5"
  },
  "productName": "AI Command Center",
  "description": "Centre de contrôle local pour Claude Code et OpenAI Codex",
  "author": "AI Command Center",
  "build": {
    "appId": "local.ai-command-center",
    "productName": "AI Command Center",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@lydell/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "electronVersion": "38.8.6",
    "icon": "build/icon.png"
  }
}
